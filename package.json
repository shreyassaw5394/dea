{
  "name": "dea-agents",
  "mcpName": "io.github.shreyassaw5394/dea",
  "version": "0.1.0",
  "description": "Debug Anything: observe and diagnose any running process, container or pod from your agent with one CLI and MCP server. Evidence, not guesses.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shreyassaw5394/dea.git"
  },
  "homepage": "https://github.com/shreyassaw5394/dea#readme",
  "bugs": {
    "url": "https://github.com/shreyassaw5394/dea/issues"
  },
  "keywords": [
    "debugging",
    "observability",
    "profiling",
    "strace",
    "py-spy",
    "perf",
    "flamegraph",
    "tcpdump",
    "lsof",
    "gdb",
    "heap-snapshot",
    "agents",
    "agent-skills",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "cli",
    "dea"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "dea": "dist/cli.js",
    "dea-agents": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "skills",
    "server.json",
    "README.md",
    "DISCLAIMER.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "serve": "tsx src/cli.ts serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src tests",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "schemas": "tsx scripts/export-schemas.ts",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^15.0.0",
    "execa": "^10.1.1",
    "picocolors": "^1.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "oxlint": "^1.88.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
