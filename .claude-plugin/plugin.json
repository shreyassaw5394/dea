  "license": "MIT",
  "keywords": ["debugging", "observability", "profiling", "strace", "py-spy", "perf", "tcpdump", "memory-leak", "deadlock", "mcp"],
  "mcpServers": {
    "debuganything": { "command": "npx", "args": ["-y", "debuganything@latest", "serve"] }
  },
  "skills": "./skills",
  "hooks": "./hooks/hooks.json"
}
