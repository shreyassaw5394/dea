{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-07-09/server.schema.json",
  "name": "io.github.shreyassaw5394/dea",
  "description": "Debug Anything: observe and diagnose any running process, container or pod with strace, py-spy, perf, lsof, tcpdump, gdb/lldb and heap snapshots. Evidence, not guesses.",
  "status": "active",
  "repository": {
    "url": "https://github.com/shreyassaw5394/dea",
    "source": "github"
  },
  "version": "0.2.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "dea-agents",
      "version": "0.2.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        }
      ]
    }
  ],
  "websiteUrl": "https://shreyassaw5394.github.io/dea"
}
