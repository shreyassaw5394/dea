{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-07-09/server.schema.json",
  "name": "io.github.shreyassaw5394/debuganything",
  "description": "Observe any running process from your agent. strace, py-spy, perf, lsof, tcpdump as evidence.",
  "status": "active",
  "repository": {
    "url": "https://github.com/shreyassaw5394/debuganything",
    "source": "github"
  },
  "version": "1.0.1",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "debuganything",
      "version": "1.0.1",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        }
      ]
    }
  ],
  "websiteUrl": "https://debuganything.dev"
}