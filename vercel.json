{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash scripts/build-site.sh",
  "outputDirectory": "_site",
  "installCommand": "echo skip",
  "framework": null,
  "cleanUrls": true,
  "headers": [
    { "source": "/(.*)\\.md", "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }] }
  ]
}
